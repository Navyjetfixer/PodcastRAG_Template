# ============================================================================
# Podcast RAG Template - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================================================
# REQUIRED
# ============================================================================

# OpenAI API Key (required for Q&A functionality)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# OPTIONAL (defaults from podcast_config.yaml will be used if not set)
# ============================================================================

# Milvus Vector Database
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_COLLECTION=podcast_segments

# Transcripts Directory (override default)
# TRANSCRIPTS_DIR=./transcripts

# Web Server
# WEB_HOST=0.0.0.0
# WEB_PORT=8000
# WEB_RELOAD=true

# Embedding Model
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DIM=384

# LLM Configuration
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=500

# Search Settings
# DEFAULT_TOP_K=5
# DEFAULT_MIN_SCORE=0.3
# USE_RERANKER=true
# RERANKER_MODEL=balanced

# ============================================================================
# ADVANCED (rarely need to change)
# ============================================================================

# Data Directories
# DATA_DIR=./data
# LOGS_DIR=./logs
# CONVERSATIONS_DIR=./.web_conversations

# Chunking
# CHUNK_SIZE=3500
# CHUNK_OVERLAP=200

# Transcription
# WHISPER_MODEL=tiny.en
# USE_FASTER_WHISPER=true
# BEAM_SIZE=5
# VAD_FILTER=true
